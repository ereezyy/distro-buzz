{
  "name": "@distro-buzz/worker",
  "version": "0.1.0",
  "description": "Distro Buzz job queue worker",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --outdir=dist",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@distro-buzz/shared": "workspace:*",
    "bull": "^4.11.0",
    "redis": "^4.6.0",
    "pg": "^8.10.0",
    "axios": "^1.4.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^3.12.0",
    "vitest": "^0.34.0",
    "@types/node": "^20.0.0",
    "eslint": "^8.40.0",
    "prettier": "^2.8.0",
    "esbuild": "^0.18.0"
  }
}
